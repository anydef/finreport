# Copy to finreport-rs/.env for local dev (that file is gitignored).
#
# Used by `just dev-be` / `make migrate` / `make generate-entities`, and by
# cargo when running binaries directly from within finreport-rs/ (dotenv()
# picks up .env from the process's working directory).
#
# All four of these are optional on `Settings` itself and validated per entry
# point instead, so a binary that doesn't need a field never fails just
# because it's unset:
# - APP_database_url is required by webapp/projector/legacy-backfill/
#   user-admin (anything that touches Postgres) but not by import-transactions
#   or init-session, which only need Comdirect credentials.
# - APP_oauth_url/APP_url/APP_save_file_path are required by the importer
#   binaries (import-transactions, init-session) but not by webapp/projector,
#   which never call the Comdirect API.
APP_database_url=postgresql://finreport:finreport@127.0.0.1:5432/finreport
APP_oauth_url=https://api.comdirect.de
APP_url=https://api.comdirect.de/api
APP_save_file_path=.session.json

# Event-log dual-write target. Leave it unset for local dev: publishing is then
# disabled entirely and the importer just writes Postgres, as it always has.
# Point it at a local broker (see docs/kafka-migration.md) to exercise the
# Kafka path.
#APP_kafka_brokers=127.0.0.1:9092

# Auth (§4). Secure cookies are the default; set this false only for
# plain-HTTP localhost.
APP_cookie_secure=false
# Comma-separated CORS allow-list checked against the request's Origin header.
# Empty/unset means no cross-origin request is allowed (fail closed).
APP_allowed_origins=http://localhost:5173
#APP_session_ttl_days=30
# When set, the projector links every newly projected account to this user in
# the same transaction (§4). Leave unset to link accounts manually via
# `user-admin link`.
#APP_projector_default_owner=local-dev

# Comdirect credentials — only exercised by the importer binaries
# (import-transactions, init-session). `dev-be` doesn't need them at all: it
# just serves GraphQL against the DB and never calls the Comdirect API.
# For real imports, use `just import-local`, which pulls these from 1Password
# instead of this file.
#
# Multiple logins are configured as numbered accounts. The importer runs them
# all in one process, one task each, so every login approves its own push-TAN
# and keeps its own session file. `just import-local --account 1` narrows a run
# to a single login.
APP_accounts__0__name=Main
APP_accounts__0__client_id=local-dev
APP_accounts__0__client_secret=local-dev
APP_accounts__0__zugangsnummer=local-dev
APP_accounts__0__pin=local-dev
#APP_accounts__1__name=Second
#APP_accounts__1__client_id=local-dev
#APP_accounts__1__client_secret=local-dev
#APP_accounts__1__zugangsnummer=local-dev
#APP_accounts__1__pin=local-dev

# __name is a free-text, human-readable label, stored on every account row this
# login imports (account.account_name) so accounts can be told apart by whose
# login they came from. It is display only — `--account` selects on the key
# ("0", "1", ...), never on the name — and may be left unset (stored as NULL).

# The session file defaults to APP_save_file_path with the account key spliced
# in (.session.0.json, .session.1.json); override per account if you want:
#APP_accounts__1__save_file_path=.session.joint.json

# The older flat form (APP_client_id / APP_client_secret / APP_zugangsnummer /
# APP_pin, no account key, labelled with APP_account_name) still works and
# counts as a single account named "default". It is ignored as soon as any
# APP_accounts__* var is set.
